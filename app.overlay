#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	aliases {
		rgb-red = &rgb_red;
		rgb-green = &rgb_green;
		rgb-blue = &rgb_blue;
	};

	/*
	 * External RGB LED is common-anode: PB11 is red, PB9 is green,
	 * and PB15 is blue. The common anode connects to 3V3.
	 */
	rgb_channels: rgb_channels {
		compatible = "gpio-leds";

		rgb_red: red {
			gpios = <&gpiob 11 GPIO_ACTIVE_LOW>;
			label = "RGB red";
		};

		rgb_green: green {
			gpios = <&gpiob 9 GPIO_ACTIVE_LOW>;
			label = "RGB green";
		};

		rgb_blue: blue {
			gpios = <&gpiob 15 GPIO_ACTIVE_LOW>;
			label = "RGB blue";
		};
	};

	zephyr,user {
		/* Arduino A0 = PB1 = ADC1_IN5 on NUCLEO-WL55JC. */
		io-channels = <&adc1 5>;
		io-channel-names = "brightness";
	};
};

&adc1 {
	#address-cells = <1>;
	#size-cells = <0>;

	channel@5 {
		reg = <5>;
		zephyr,gain = "ADC_GAIN_1";
		/* Required by Zephyr 4.1.0's STM32 ADC driver. */
		zephyr,reference = "ADC_REF_INTERNAL";
		/* LDR dividers are high impedance; use STM32WL's longest sample time. */
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};
};
